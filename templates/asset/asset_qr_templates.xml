<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════
         ASSET QR SCAN LANDING PAGE
         Mobile-optimised page shown when a QR code is scanned.
         Shows asset info and role-based action buttons.
    ══════════════════════════════════════════════════════════ -->
    <template id="asset_scan_page" name="Asset QR Scan Page">
        <t t-call="web.layout">
            <t t-set="head_asset">
                <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1"/>
                <style>
                    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
                    background: #f0f4f8; margin: 0; padding: 0; }
                    .scan-container { max-width: 480px; margin: 0 auto; padding: 16px; }
                    .scan-card { background: #fff; border-radius: 16px;
                    box-shadow: 0 4px 20px rgba(0,0,0,0.10);
                    padding: 24px; margin-bottom: 16px; }
                    .asset-header { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
                    .asset-icon { width: 56px; height: 56px; background: #2563EB;
                    border-radius: 14px; display: flex; align-items: center;
                    justify-content: center; flex-shrink: 0; }
                    .asset-icon i { color: #fff; font-size: 24px; }
                    .asset-title { font-size: 1.2rem; font-weight: 700; color: #111827; }
                    .asset-code { font-size: 0.85rem; color: #6B7280; }
                    .badge-status { display: inline-block; padding: 4px 12px;
                    border-radius: 20px; font-size: 0.78rem; font-weight: 700; }
                    .badge-active { background: #dcfce7; color: #16a34a; }
                    .badge-maintenance { background: #fef3c7; color: #d97706; }
                    .badge-other { background: #e5e7eb; color: #374151; }
                    .info-row { display: flex; justify-content: space-between;
                    padding: 8px 0; border-bottom: 1px solid #f3f4f6;
                    font-size: 0.9rem; }
                    .info-label { color: #6B7280; font-weight: 500; }
                    .info-value { color: #111827; font-weight: 600; text-align: right; }
                    .action-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
                    .action-btn { display: flex; flex-direction: column; align-items: center;
                    justify-content: center; padding: 16px 8px;
                    border-radius: 14px; border: none; cursor: pointer;
                    font-size: 0.8rem; font-weight: 700; text-decoration: none;
                    transition: transform 0.1s, box-shadow 0.1s; }
                    .action-btn:active { transform: scale(0.97); }
                    .action-btn i { font-size: 22px; margin-bottom: 6px; }
                    .btn-blue { background: #dbeafe; color: #1d4ed8; }
                    .btn-green { background: #dcfce7; color: #15803d; }
                    .btn-amber { background: #fef3c7; color: #b45309; }
                    .btn-red { background: #fee2e2; color: #dc2626; }
                    .btn-purple { background: #ede9fe; color: #7c3aed; }
                    .btn-teal { background: #ccfbf1; color: #0f766e; }
                    .section-title { font-size: 0.75rem; font-weight: 800;
                    color: #9ca3af; text-transform: uppercase;
                    letter-spacing: 0.06em; margin-bottom: 12px; }
                    #map-frame { width: 100%; height: 200px; border-radius: 12px;
                    border: none; display: none; }
                    .gps-msg { font-size: 0.8rem; color: #6B7280; text-align: center;
                    padding: 8px; }
                </style>
                <!-- GPS capture script — runs immediately on page load -->
                <script>
                    (function() {
                    var assetId = '<t t-esc="asset.id"/>';
                    if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition(
                    function(pos) {
                    var lat = pos.coords.latitude;
                    var lng = pos.coords.longitude;
                    // POST coords back to update scan log
                    fetch('/asset/update_location', {
                    method: 'POST',
                    headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({
                    jsonrpc: '2.0', method: 'call', id: 1,
                    params: { asset_id: parseInt(assetId), lat: lat, lng: lng }
                    })
                    });
                    var frame = document.getElementById('map-frame');
                    if (frame) {
                    frame.src = 'https://maps.google.com/maps?q=' + lat + ',' + lng + '&amp;z=18&amp;output=embed';
                    frame.style.display = 'block';
                    document.getElementById('gps-msg').style.display = 'none';
                    }
                    },
                    function(err) {
                    var el = document.getElementById('gps-msg');
                    if (el) el.textContent = 'Location unavailable (' + err.message + ')';
                    },
                    { timeout: 8000, maximumAge: 60000 }
                    );
                    }
                    })();
                </script>
            </t>

            <div class="scan-container">

                <!-- Asset Header Card -->
                <div class="scan-card">
                    <div class="asset-header">
                        <div class="asset-icon">
                            <i class="fa fa-cube"/>
                        </div>
                        <div>
                            <div class="asset-title">
                                <t t-esc="asset.name"/>
                            </div>
                            <div class="asset-code">
                                <t t-esc="asset.asset_code"/>
                            </div>
                        </div>
                        <div style="margin-left:auto;">
                            <t t-if="asset.state == 'active'">
                                <span class="badge-status badge-active">Active</span>
                            </t>
                            <t t-elif="asset.state == 'under_maintenance'">
                                <span class="badge-status badge-maintenance">Maintenance</span>
                            </t>
                            <t t-else="">
                                <span class="badge-status badge-other">
                                    <t t-esc="asset.state"/>
                                </span>
                            </t>
                        </div>
                    </div>

                    <!-- Asset Info Rows -->
                    <div class="info-row">
                        <span class="info-label">Category</span>
                        <span class="info-value">
                            <t t-esc="asset.category_id.name or '—'"/>
                        </span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Department</span>
                        <span class="info-value">
                            <t t-esc="asset.department_id.name or '—'"/>
                        </span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Location</span>
                        <span class="info-value">
                            <t t-esc="asset.location_id.complete_name or asset.room or '—'"/>
                        </span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Serial No.</span>
                        <span class="info-value">
                            <t t-esc="asset.serial_number or '—'"/>
                        </span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Condition</span>
                        <span class="info-value">
                            <t t-esc="asset.condition or '—'"/>
                        </span>
                    </div>
                    <t t-if="asset.last_scan_date">
                        <div class="info-row" style="border-bottom:none;">
                            <span class="info-label">Last Scanned</span>
                            <span class="info-value">
                                <t t-esc="asset.last_scan_date.strftime('%d %b %Y %H:%M')"/>
                            </span>
                        </div>
                    </t>
                </div>

                <!-- Action Buttons — shown based on role -->
                <div class="scan-card">
                    <div class="section-title">Actions</div>
                    <div class="action-grid">

                        <!-- All users: raise an asset request -->
                        <a class="action-btn btn-blue"
                           t-attf-href="/web#action=university_management.action_asset_request&amp;view_type=form&amp;default_asset_id={{ asset.id }}&amp;default_asset_category_id={{ asset.category_id.id }}">
                            <i class="fa fa-plus-circle"/>
                            Request Asset
                        </a>

                        <!-- All users: view asset details in backend -->
                        <a class="action-btn btn-teal"
                           t-attf-href="/web#model=asset.asset&amp;id={{ asset.id }}&amp;view_type=form">
                            <i class="fa fa-info-circle"/>
                            View Details
                        </a>

                        <!-- IT Team / Admin: raise maintenance -->
                        <t t-if="is_it_team or is_admin">
                            <a class="action-btn btn-amber"
                               t-attf-href="/web#action=university_management.action_asset_maintenance&amp;view_type=form&amp;default_asset_id={{ asset.id }}">
                                <i class="fa fa-wrench"/>
                                Maintenance
                            </a>
                        </t>

                        <!-- IT Team / Admin: raise transfer -->
                        <t t-if="is_it_team or is_admin or is_hod">
                            <a class="action-btn btn-purple"
                               t-attf-href="/web#action=university_management.action_asset_transfer&amp;view_type=form&amp;default_asset_id={{ asset.id }}">
                                <i class="fa fa-exchange"/>
                                Transfer
                            </a>
                        </t>

                        <!-- Admin: open full edit form -->
                        <t t-if="is_admin">
                            <a class="action-btn btn-green"
                               t-attf-href="/web#model=asset.asset&amp;id={{ asset.id }}&amp;view_type=form">
                                <i class="fa fa-edit"/>
                                Edit Asset
                            </a>
                        </t>

                        <!-- Show purchase order if linked (IT/Admin) -->
                        <t t-if="(is_it_team or is_admin) and asset.purchase_order_id">
                            <a class="action-btn btn-green"
                               t-attf-href="/web#model=purchase.order&amp;id={{ asset.purchase_order_id.id }}&amp;view_type=form">
                                <i class="fa fa-shopping-cart"/>
                                View PO
                            </a>
                        </t>

                    </div>
                </div>

                <!-- GPS Map -->
                <div class="scan-card" style="padding:12px;">
                    <div class="section-title">Current Location</div>
                    <p class="gps-msg" id="gps-msg">Detecting your location…</p>
                    <iframe id="map-frame" allowfullscreen="1" loading="lazy"
                            title="Asset current GPS location"/>
                </div>

                <!-- Footer -->
                <div style="text-align:center; color:#9ca3af; font-size:0.75rem; padding:12px 0 24px;">
                    Scanned by
                    <strong>
                        <t t-esc="user.name"/>
                    </strong>
                    ·
                    University Asset Management
                </div>

            </div>
        </t>
    </template>

    <!-- ══════════════════════════════════════════════════════
         INVALID / EXPIRED QR TOKEN PAGE
    ══════════════════════════════════════════════════════════ -->
    <template id="asset_scan_invalid" name="Asset QR Invalid">
        <t t-call="web.layout">
            <t t-set="head_asset">
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <style>
                    body { font-family: -apple-system, BlinkMacSystemFont, sans-serif;
                    background:#fff1f2; display:flex; align-items:center;
                    justify-content:center; min-height:100vh; margin:0; }
                    .err-card { background:#fff; border-radius:20px; padding:40px 32px;
                    text-align:center; max-width:360px;
                    box-shadow:0 8px 30px rgba(220,38,38,0.12); }
                    .err-icon { font-size:56px; color:#dc2626; margin-bottom:16px; }
                    h2 { color:#111827; font-size:1.3rem; margin-bottom:8px; }
                    p { color:#6B7280; font-size:0.9rem; margin-bottom:24px; }
                    .back-btn { background:#2563EB; color:#fff; border:none;
                    border-radius:10px; padding:12px 28px; font-size:1rem;
                    font-weight:700; cursor:pointer; text-decoration:none; }
                </style>
            </t>
            <div class="err-card">
                <div class="err-icon">
                    <i class="fa fa-ban"/>
                </div>
                <h2>Invalid QR Code</h2>
                <p>
                    <t t-if="error">
                        <t t-esc="error"/>
                    </t>
                    <t t-else="">This QR code is invalid, expired, or has been tampered with.</t>
                </p>
                <a href="/" class="back-btn">Go to Dashboard</a>
            </div>
        </t>
    </template>

    <!-- ══════════════════════════════════════════════════════
         ASSET REQUEST SUBMITTED CONFIRMATION PAGE
    ══════════════════════════════════════════════════════════ -->
    <template id="asset_request_submitted" name="Asset Request Submitted">
        <t t-call="web.layout">
            <t t-set="head_asset">
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <style>
                    body { font-family: -apple-system, BlinkMacSystemFont, sans-serif;
                    background:#f0fdf4; display:flex; align-items:center;
                    justify-content:center; min-height:100vh; margin:0; }
                    .ok-card { background:#fff; border-radius:20px; padding:40px 32px;
                    text-align:center; max-width:380px;
                    box-shadow:0 8px 30px rgba(22,163,74,0.10); }
                    .ok-icon { font-size:56px; color:#16a34a; margin-bottom:16px; }
                    h2 { color:#111827; font-size:1.3rem; margin-bottom:8px; }
                    p { color:#6B7280; font-size:0.9rem; margin-bottom:8px; }
                    .ref { background:#dcfce7; color:#15803d; border-radius:8px;
                    padding:8px 16px; font-weight:700; display:inline-block;
                    margin-bottom:24px; font-size:1rem; }
                    .back-btn { background:#2563EB; color:#fff; border:none;
                    border-radius:10px; padding:12px 28px; font-size:1rem;
                    font-weight:700; cursor:pointer; text-decoration:none; }
                </style>
            </t>
            <div class="ok-card">
                <div class="ok-icon">
                    <i class="fa fa-check-circle"/>
                </div>
                <h2>Request Submitted!</h2>
                <p>Your asset request has been submitted and routed to the IT helpdesk.</p>
                <div class="ref">
                    <t t-esc="request.name"/>
                </div>
                <p>
                    Helpdesk ticket:
                    <strong>
                        <t t-if="request.helpdesk_ticket_id">
                            <t t-esc="request.helpdesk_ticket_id.name"/>
                        </t>
                        <t t-else="">—</t>
                    </strong>
                </p>
                <a href="/web" class="back-btn">Go to Dashboard</a>
            </div>
        </t>
    </template>

</odoo>
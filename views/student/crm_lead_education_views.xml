<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         EXTEND THE STANDARD CRM LEAD FORM VIEW
         We inherit the default crm.lead form and inject an
         "Education" page into the notebook, plus smart buttons
         for seat blocking and admission.
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="crm_lead_education_form_view" model="ir.ui.view">
        <field name="name">crm.lead.education.form.view</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!-- Smart buttons: inject after existing button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_edu_view_seat_blocking"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-lock"
                        invisible="not edu_seat_blocking_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Seat</span>
                        <span class="o_stat_text">Blocking</span>
                    </div>
                </button>
                <button name="action_edu_view_admission"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="not edu_admission_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Admission</span>
                        <span class="o_stat_text">Application</span>
                    </div>
                </button>
                <button name="action_edu_view_sessions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-comments">
                    <field name="edu_session_count"
                           widget="statinfo"
                           string="Sessions"/>
                </button>
            </xpath>

            <!-- Action buttons: inject before the standard Mark Won button -->
            <xpath expr="//button[@name='action_set_won_rainbowman']" position="before">
                <button name="action_edu_new_session"
                        string="Add Session"
                        type="object"
                        icon="fa-plus"
                        groups="base.group_user"/>
                <button name="action_edu_mark_counselled"
                        string="Mark Counselled"
                        type="object"
                        invisible="not edu_counselling_date or edu_counselling_done_date"/>
                <button name="action_edu_convert_to_seat_blocking"
                        string="Block Seat"
                        type="object"
                        class="oe_highlight"
                        invisible="edu_seat_blocking_id or edu_admission_id or not edu_program_id"
                        confirm="Create a seat blocking for this applicant?"
                        groups="base.group_user"/>
                <button name="action_edu_convert_to_admission"
                        string="Create Admission"
                        type="object"
                        class="oe_highlight"
                        invisible="edu_admission_id or not edu_program_id"
                        confirm="Convert directly to an admission application (no seat blocking)?"
                        groups="base.group_user"/>
            </xpath>

            <!-- Education tab: inject as last page in the notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Education Details" name="education_details">

                    <group>
                        <group string="Program of Interest">
                            <field name="edu_program_id"
                                   options="{'no_create': True}"/>
                            <field name="edu_department_id" readonly="1"/>
                            <field name="edu_alternate_program_id"
                                   options="{'no_create': True}"/>
                            <field name="edu_academic_year_id"
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="Personal Details">
                            <field name="edu_date_of_birth" widget="date"/>
                            <field name="edu_gender"/>
                            <field name="edu_city"/>
                            <field name="edu_state_id"
                                   options="{'no_create': True}"/>
                            <field name="edu_referral_name"
                                   invisible="source_id.name not in ['Referral', 'referral']"
                                   placeholder="Name of referring student / person"/>
                        </group>
                    </group>

                    <group>
                        <group string="Previous Education">
                            <field name="edu_previous_qualification"/>
                            <field name="edu_previous_school"
                                   placeholder="School / College name"/>
                            <field name="edu_previous_percentage"/>
                            <field name="edu_previous_year"/>
                        </group>
                        <group string="Entrance Exams">
                            <field name="edu_entrance_exam_taken"
                                   widget="boolean_toggle"/>
                            <field name="edu_entrance_exam_name"
                                   invisible="not edu_entrance_exam_taken"
                                   placeholder="JEE / KCET / COMEDK / NEET"/>
                            <field name="edu_entrance_exam_score"
                                   invisible="not edu_entrance_exam_taken"/>
                            <field name="edu_entrance_exam_rank"
                                   invisible="not edu_entrance_exam_taken"/>
                            <field name="edu_entrance_exam_percentile"
                                   invisible="not edu_entrance_exam_taken"/>
                        </group>
                    </group>

                    <group string="Counselling Session (Quick)">
                        <group>
                            <field name="edu_counselling_date" widget="datetime"/>
                            <field name="edu_counselling_mode"/>
                            <field name="edu_counselling_done_date"
                                   widget="date" readonly="1"
                                   invisible="not edu_counselling_done_date"/>
                        </group>
                        <group>
                            <field name="edu_seat_blocking_id" readonly="1"
                                   invisible="not edu_seat_blocking_id"/>
                            <field name="edu_admission_id" readonly="1"
                                   invisible="not edu_admission_id"/>
                        </group>
                    </group>

                    <!-- Sessions inline list -->
                    <separator string="Counselling Sessions"/>
                    <field name="edu_session_ids"
                           context="{
                               'default_lead_id': id,
                               'default_counsellor_id': user_id,
                               'default_program_discussed_id': edu_program_id
                           }">
                        <list string="Sessions"
                              editable="bottom"
                              decoration-success="state == 'completed'"
                              decoration-warning="state == 'no_show'">
                            <field name="session_number" readonly="1" string="#"/>
                            <field name="session_date" widget="datetime"/>
                            <field name="counsellor_id"
                                   options="{'no_create': True}"/>
                            <field name="session_mode"/>
                            <field name="program_discussed_id"
                                   options="{'no_create': True}"/>
                            <field name="eligibility_status" widget="badge"
                                   decoration-success="eligibility_status == 'eligible'"
                                   decoration-warning="eligibility_status == 'conditional'"
                                   decoration-danger="eligibility_status == 'not_eligible'"
                                   decoration-info="eligibility_status == 'pending'"/>
                            <field name="outcome" widget="badge"
                                   decoration-success="outcome in ['interested', 'seat_blocked', 'applied']"
                                   decoration-danger="outcome in ['not_interested', 'chose_competitor']"
                                   decoration-warning="outcome in ['needs_follow_up', 'considering']"/>
                            <field name="follow_up_date" optional="show"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'completed'"
                                   decoration-warning="state == 'no_show'"/>
                            <button name="action_complete"
                                    string="Complete"
                                    type="object"
                                    icon="fa-check"
                                    invisible="state != 'scheduled'"/>
                            <button name="action_no_show"
                                    string="No Show"
                                    type="object"
                                    icon="fa-times"
                                    invisible="state != 'scheduled'"/>
                        </list>
                    </field>

                </page>
            </xpath>

        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         EDUCATION-SPECIFIC CRM PIPELINE VIEW
         A standalone kanban action filtered to education leads only
         (those that have edu_program_id set). This gives the
         admissions team their own clean pipeline without seeing
         unrelated CRM leads.
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="action_edu_crm_pipeline" model="ir.actions.act_window">
        <field name="name">Admission Pipeline</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form,graph,pivot,activity</field>
        <field name="domain">[('type', '=', 'opportunity'), ('edu_program_id', '!=', False)]</field>
        <field name="context">{
            'default_type': 'opportunity',
            'search_default_filter_active': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No admission leads yet
            </p>
            <p>
                Create a new lead to start tracking a prospective student
                through the admission counselling pipeline.
                Convert leads to Seat Blockings or Admission Applications
                using the action buttons on each lead.
            </p>
        </field>
    </record>

    <!-- Walk-in leads action — type=lead (not opportunity yet) -->
    <record id="action_edu_crm_leads" model="ir.actions.act_window">
        <field name="name">Enquiries (Raw Leads)</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('type', '=', 'lead')]</field>
        <field name="context">{
            'default_type': 'lead',
        }</field>
    </record>

</odoo>
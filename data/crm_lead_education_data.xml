<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ═══════════════════════════════════════════════════════════
             CRM PIPELINE STAGES — Education Admission Pipeline
             noupdate=1 so manual admin changes are preserved on upgrade.
             Note: probability and requirements removed — not on crm.stage in Odoo 18
        ════════════════════════════════════════════════════════════════ -->

        <record id="crm_stage_new_enquiry" model="crm.stage">
            <field name="name">New Enquiry</field>
            <field name="sequence">1</field>
        </record>

        <record id="crm_stage_contacted" model="crm.stage">
            <field name="name">Contacted</field>
            <field name="sequence">2</field>
        </record>

        <record id="crm_stage_counselling_scheduled" model="crm.stage">
            <field name="name">Counselling Scheduled</field>
            <field name="sequence">3</field>
        </record>

        <record id="crm_stage_counselled" model="crm.stage">
            <field name="name">Counselled</field>
            <field name="sequence">4</field>
        </record>

        <record id="crm_stage_interested" model="crm.stage">
            <field name="name">Interested</field>
            <field name="sequence">5</field>
        </record>

        <record id="crm_stage_seat_blocked" model="crm.stage">
            <field name="name">Seat Blocked</field>
            <field name="sequence">6</field>
            <field name="is_won">False</field>
        </record>

        <record id="crm_stage_admitted" model="crm.stage">
            <field name="name">Admitted</field>
            <field name="sequence">7</field>
            <field name="is_won">True</field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════
             DEFAULT ADMISSION TEAM
        ════════════════════════════════════════════════════════════════ -->
        <record id="crm_team_admissions" model="crm.team">
            <field name="name">Admission &amp; Counselling</field>
            <field name="use_leads">True</field>
            <field name="use_opportunities">True</field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════
             UTM LEAD SOURCES
        ════════════════════════════════════════════════════════════════ -->
        <record id="utm_source_education_fair" model="utm.source">
            <field name="name">Education Fair</field>
        </record>

        <record id="utm_source_walk_in" model="utm.source">
            <field name="name">Walk-in</field>
        </record>

        <record id="utm_source_referral" model="utm.source">
            <field name="name">Referral</field>
        </record>

        <record id="utm_source_school_visit" model="utm.source">
            <field name="name">School Visit</field>
        </record>

        <record id="utm_source_phone_enquiry" model="utm.source">
            <field name="name">Phone Enquiry</field>
        </record>

        <record id="utm_source_whatsapp" model="utm.source">
            <field name="name">WhatsApp</field>
        </record>

    </data>
</odoo>
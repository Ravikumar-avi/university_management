<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="university_management.AIAssistant">
    <div class="uni-ai-wrapper">

        <!-- ── FAB: large white circle, blue border on hover ── -->
        <button class="uni-ai-fab" t-on-click="toggleChat" title="AI Assistant">
            <!-- Two-sparkle icon: big 4-point star + small 4-point star (matches reference exactly) -->
            <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Large sparkle -->
                <path d="M22 6 C22 6 24 18 28 22 C32 26 44 28 44 28 C44 28 32 30 28 34 C24 38 22 50 22 50 C22 50 20 38 16 34 C12 30 0 28 0 28 C0 28 12 26 16 22 C20 18 22 6 22 6 Z"
                      fill="#3D4EE8"/>
                <!-- Small sparkle -->
                <path d="M44 8 C44 8 45 13 47 15 C49 17 54 18 54 18 C54 18 49 19 47 21 C45 23 44 28 44 28 C44 28 43 23 41 21 C39 19 34 18 34 18 C34 18 39 17 41 15 C43 13 44 8 44 8 Z"
                      fill="#3D4EE8"/>
            </svg>
        </button>

        <!-- ── Chat Window ── -->
        <t t-if="state.isOpen">
            <div class="uni-ai-window">

                <!-- Header -->
                <div class="uni-ai-header">
                    <div class="uni-ai-header__spacer"/>
                    <div class="uni-ai-header__center">
                        <div class="uni-ai-header__title">
                            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M8 2 C8 2 8.8 7 10 8.5 C11.2 10 16 10.8 16 10.8 C16 10.8 11.2 11.6 10 13 C8.8 14.5 8 19 8 19 C8 19 7.2 14.5 6 13 C4.8 11.5 0 10.8 0 10.8 C0 10.8 4.8 10 6 8.5 C7.2 7 8 2 8 2 Z" fill="#3D4EE8"/>
                                <path d="M16 1 C16 1 16.5 3.5 17.5 4.5 C18.5 5.5 21 6 21 6 C21 6 18.5 6.5 17.5 7.5 C16.5 8.5 16 11 16 11 C16 11 15.5 8.5 14.5 7.5 C13.5 6.5 11 6 11 6 C11 6 13.5 5.5 14.5 4.5 C15.5 3.5 16 1 16 1 Z" fill="#3D4EE8"/>
                            </svg>
                            AI Business Companion
                        </div>
                        <div class="uni-ai-header__subtitle">University Assistant</div>
                    </div>
                    <div class="uni-ai-header__actions">
                        <button class="uni-ai-icon-btn" t-on-click="toggleChat" title="Minimise">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                                <path d="M8 3L3 8M3 8H8M3 8V3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M16 21L21 16M21 16H16M21 16V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Messages -->
                <div class="uni-ai-messages" t-ref="messages">
                    <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                        <div t-att-class="'uni-ai-msg uni-ai-msg--' + msg.role + (msg.isError ? ' uni-ai-msg--error' : '')">
                            <t t-if="msg.role === 'assistant'">
                                <div class="uni-ai-msg__avatar">AI</div>
                            </t>
                            <div class="uni-ai-msg__bubble">
                                <t t-out="formatMessage(msg.content)"/>
                            </div>
                        </div>
                    </t>
                    <t t-if="state.isLoading">
                        <div class="uni-ai-msg uni-ai-msg--assistant">
                            <div class="uni-ai-msg__avatar">AI</div>
                            <div class="uni-ai-msg__bubble uni-ai-msg__bubble--typing">
                                <span/><span/><span/>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Quick action pills -->
                <div class="uni-ai-quick-actions">
                    <t t-foreach="suggestions" t-as="s" t-key="s">
                        <button class="uni-ai-quick-btn" t-on-click="() => askSuggested(s)">
                            <t t-esc="s"/>
                        </button>
                    </t>
                    <button class="uni-ai-quick-btn uni-ai-quick-btn--clear" t-on-click="clearChat">
                        Clear All
                    </button>
                </div>

                <!-- Input row -->
                <div class="uni-ai-input-row">
                    <button class="uni-ai-attach-btn" title="Attach" disabled="1">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                            <path d="M21.44 11.05L12.25 20.24C11.12 21.37 9.59 22 8 22C6.41 22 4.88 21.37 3.75 20.24C2.62 19.11 1.99 17.58 1.99 15.99C1.99 14.4 2.62 12.87 3.75 11.74L12.94 2.55C13.69 1.8 14.71 1.38 15.77 1.38C16.83 1.38 17.85 1.8 18.6 2.55C19.35 3.3 19.77 4.32 19.77 5.38C19.77 6.44 19.35 7.46 18.6 8.21L9.4 17.41C9.02 17.79 8.51 18 7.98 18C7.45 18 6.94 17.79 6.56 17.41C6.18 17.03 5.97 16.52 5.97 15.99C5.97 15.46 6.18 14.95 6.56 14.57L15.07 6.06" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                    <textarea
                        class="uni-ai-input"
                        placeholder="Type your message here..."
                        rows="1"
                        t-att-value="state.inputText"
                        t-on-input="onInput"
                        t-on-keydown="onInputKeydown"
                        t-att-disabled="state.isLoading"
                    />
                    <div class="uni-ai-input-actions">
                        <button
                            class="uni-ai-round-btn uni-ai-round-btn--send"
                            t-on-click="sendMessage"
                            t-att-disabled="!state.inputText.trim() or state.isLoading"
                            title="Send"
                        >
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                                <path d="M22 2L11 13M22 2L15 22L11 13M22 2L2 9L11 13" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                        <button class="uni-ai-round-btn" title="Voice" disabled="1">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                                <rect x="9" y="2" width="6" height="12" rx="3" stroke="currentColor" stroke-width="2"/>
                                <path d="M5 10C5 14.42 8.13 18 12 18C15.87 18 19 14.42 19 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                <line x1="12" y1="18" x2="12" y2="22" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </button>
                    </div>
                </div>

            </div>
        </t>

    </div>
</t>

</templates>